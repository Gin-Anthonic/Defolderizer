<Window x:Class="Defolderizer_Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Defolderizer_Installer"
        mc:Ignorable="d"
        Title="Installer" Height="400" Width="450" MinWidth="450" MinHeight="400">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="80" />
            <RowDefinition Height="10" />
            <RowDefinition Height="60" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" HorizontalAlignment="Stretch" Fill="Gray" Height="1"/>
        <Rectangle Grid.Row="3" HorizontalAlignment="Stretch" Fill="Gray" Height="1"/>

        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>
            
            <Label Content="Install Path:" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBox Name="TbInstallPath"   Grid.Column="1"
                     VerticalAlignment="Center" HorizontalAlignment="Center"
                     Width="280"
                     LostFocus="TbInstallPath_LostFocus" 
                     Text="{Binding InstallPath}"
                 />
            <Button Name="BtnBrowse" Content="Browse" 
                    Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"
                    Width="44" 
                    Click="BtnBrowse_Click"
                />
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="195"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>


            <CheckBox Name="CbInstallForAllUsers" 
                      Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                      Width="100"
                      Content="For all Users" 
                      ToolTip="Add  for all users on this PC" 
                      IsChecked="{Binding InstallForAllUsers}"
                      IsEnabled="{Binding AddToRightClick}"
                      />
            <CheckBox Name="CbAddToRightClick" 
                      Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                      Width="120"
                      Content="Add to Right-Click"
                      ToolTip="Add to Right Click Menu on Directories"
                      IsChecked="{Binding AddToRightClick}" 
                  />

            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="110"
                   Content="Position:" />
            <ComboBox Name="CmbPosition"
                      Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" 
                      Width="110" SelectedIndex="{Binding SelectedMenuPositionIndex}"
                      ToolTip="Where the options in the Menu will appear&#x0a;System Default: Let Windows decide where the options appear"
                      
                      >
                <ComboBoxItem Content="Bottom" />
                <ComboBoxItem Content="Top" />
                <ComboBoxItem Content="System Default" />

            </ComboBox>
            <Button Content="Add Menu Items" Name="BtnAddRegistryEdits"
                    Grid.Column="2" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Click="BtnAddRegistryEdits_Click"/>           
            <Button Content="Remove Menu Items" Name="BtnRemoveRegistryEdits"
                    Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                    Click="BtnRemoveRegistryEdits_Click"/>
        </Grid>

        <Button Name="BtnInstall" Content="Install" Grid.Row="4"
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Width="200" Height="40"
                Click="BtnInstall_Click"
                />
        <TextBlock Name="TblOutput" Grid.Row="5"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10"
                   Height="Auto" Width="400"
                   Text="{Binding Output}"
                   />
    </Grid>
</Window>
