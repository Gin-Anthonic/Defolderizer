<Window x:Class="Defolderizer_Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Defolderizer_Installer"
        mc:Ignorable="d"
        Title="Installer" Height="400" Width="450" MinWidth="450" MinHeight="400">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="80" />
            <RowDefinition Height="10" />
            <RowDefinition Height="60" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" HorizontalAlignment="Stretch" Fill="Gray" Height="1"/>
        <Rectangle Grid.Row="3" HorizontalAlignment="Stretch" Fill="Gray" Height="1"/>

        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>
            
            <Label Content="Install Path:" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBox Name="tbInstallPath"   Grid.Column="1"
                     VerticalAlignment="Center" HorizontalAlignment="Center"
                     Width="280"
                     LostFocus="tbInstallPath_LostFocus" GotFocus="tbInstallPath_GotFocus"
                 />
            <Button Name="btnBrowse" Content="Browse" 
                    Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"
                    Width="44" 
                    Click="btnBrowse_Click"
                />
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition MinWidth="180" MaxWidth="300"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>


            <CheckBox Name="cbInstallForAllUsers" 
                      Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                      Width="120"
                      Content="For all Users" 
                      ToolTip="Add the Registry Edits for all users on this PC" 
                      IsChecked="False" Checked="cbInstallForAllUsers_Checked"/>
            <CheckBox Name="cbAddToRightClick" 
                      Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                      Width="120"
                      Content="Add to Right-Click"
                      ToolTip="Add Registry Entries to Right Click on Directories(HIGHLY RECCOMENDED!)"
                      IsChecked="False" Unchecked="cbAddToRightClick_Unchecked" Checked="cbAddToRightClick_Checked"
                  />

            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="110"
                   Content="Position:" />
            <ComboBox Name="cmbPosition"
                      Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                      Width="110" SelectedIndex="0">
                <ComboBoxItem Content="Top" />
                <ComboBoxItem Content="Bottom" />
                <ComboBoxItem Content="System Default" />

            </ComboBox>
            <Button Content="Remove Regedits" 
                    Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="Button_Click"/>
            <Button Content="Add Regedits"
                    Grid.Column="2" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="Button_Click_1"/>
        </Grid>

        <Button Name="btnInstall" Content="Install" Grid.Row="4"
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Width="200" Height="40"
                Click="btnInstall_Click"
                />
        <TextBlock Name="tblOutput" Grid.Row="5"
                   TextWrapping="Wrap" Text="TextBlock" 
                   VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10"
                   Height="Auto" Width="400"/>




    </Grid>
</Window>
